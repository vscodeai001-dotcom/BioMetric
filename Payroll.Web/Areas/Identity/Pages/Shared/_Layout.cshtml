<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Payroll System</title>

    <!-- Bootswatch Theme + Icons (same as main layout) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/cosmo/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- MAIN APP STYLES -->
    <link rel="stylesheet" href="~/app.css" />
    <link rel="stylesheet" href="~/dark-theme.css" />
    <link rel="stylesheet" href="~/Payroll.Web.styles.css" />
</head>

<body>
    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Identity page scripts -->
    @await RenderSectionAsync("Scripts", required: false)

    <script src="~/js/themeInterop.js"></script>
    <!-- APPLY DARK/LIGHT THEME WHEN PAGE LOADS -->
    <script>
        (function () {
            try {
                // applySavedTheme returns the applied theme
                window.themeInterop.applySavedTheme();
            } catch (e) {
                console.warn('Theme init failed', e);
            }
        })();
    </script>

</body>
</html>
