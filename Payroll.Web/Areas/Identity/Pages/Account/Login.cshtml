@page
@model Payroll.Web.Areas.Identity.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="login-page">
    <div class="login-card">

        <div class="login-header">
            <div class="brand">
                Payroll.Web
            </div>

            <h1>Welcome back</h1>

            <p>
                Sign in to access your employee portal.
            </p>
        </div>


        <form method="post">

            <input type="hidden"
                   name="ReturnUrl"
                   value="@Model.ReturnUrl" />


            @if (Model.ExistingSessionDetected)
            {
                <div class="session-warning">

                    <div class="session-warning-icon">
                        🔒
                    </div>

                    <div class="session-warning-content">

                        <h3>
                            This employee is already logged in
                        </h3>

                        <p>
                            This account is currently active on
                            another device or browser.
                        </p>

                        <p>
                            Only <strong>one device</strong> can be
                            logged in to an employee account at a time.
                        </p>

                        @if (Model.ExistingSessionLastSeenUtc.HasValue)
                        {
                            <div class="last-seen">
                                Last activity recorded:
                                <strong>
                                    @Model.ExistingSessionLastSeenUtc.Value.ToString("dd MMM yyyy, hh:mm tt") UTC
                                </strong>
                            </div>
                        }

                        <div class="session-security-note">
                            If you are the account owner and no longer
                            have access to the previous device, you can
                            end that session and continue here.
                        </div>

                    </div>

                </div>
            }


            @if (ViewData.ModelState.ErrorCount > 0)
            {
                <div asp-validation-summary="ModelOnly"
                     class="login-error">
                </div>
            }


            <div class="form-group">

                <label asp-for="Input.Email">
                    Email
                </label>

                <input asp-for="Input.Email"
                       autocomplete="username"
                       autofocus
                       class="form-control"
                       placeholder="Enter your email" />

                <span asp-validation-for="Input.Email"
                      class="field-error">
                </span>

            </div>


            <div class="form-group">

                <label asp-for="Input.Password">
                    Password
                </label>

                <input asp-for="Input.Password"
                       autocomplete="current-password"
                       class="form-control"
                       placeholder="Enter your password" />

                <span asp-validation-for="Input.Password"
                      class="field-error">
                </span>

            </div>


            <div class="remember-row">

                <label class="remember-label">

                    <input asp-for="Input.RememberMe" />

                    <span>
                        Remember me
                    </span>

                </label>

                <a href="/Identity/Account/ForgotPassword">
                    Forgot password?
                </a>

            </div>


            @if (Model.ExistingSessionDetected)
            {
                <input type="hidden"
                       name="ForceLogin"
                       value="false" />

                <button type="submit"
                        name="ForceLogin"
                        value="true"
                        class="btn-force-login">

                    🔓 Force Logout Existing Session &amp; Continue

                </button>

                <div class="force-warning">

                    <strong>Important:</strong>
                    Continuing will sign out the existing
                    session on the other device.

                </div>
            }
            else
            {
                <button type="submit"
                        class="btn-login">

                    Log in

                </button>
            }

        </form>


        <div class="login-footer">

            <span>
                BioMetric Payroll
            </span>

            <span>
                Secure Employee Portal
            </span>

        </div>

    </div>
</div>


<style>

    * {
        box-sizing: border-box;
    }

    .login-page {
        min-height: calc(100vh - 100px);
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 20px;
        background: #f4f7fb;
    }

    .login-card {
        width: 100%;
        max-width: 470px;
        background: #ffffff;
        border-radius: 16px;
        padding: 36px;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.10);
        border: 1px solid #e5e9ef;
    }

    .login-header {
        text-align: center;
        margin-bottom: 28px;
    }

    .brand {
        font-size: 17px;
        font-weight: 700;
        color: #2563eb;
        margin-bottom: 18px;
    }

    .login-header h1 {
        margin: 0;
        font-size: 32px;
        font-weight: 700;
        color: #1f2937;
    }

    .login-header p {
        margin-top: 8px;
        color: #6b7280;
        font-size: 15px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        margin-bottom: 7px;
        font-weight: 600;
        color: #374151;
        font-size: 14px;
    }

    .form-control {
        width: 100%;
        height: 48px;
        padding: 0 14px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        font-size: 15px;
        outline: none;
        transition: border-color .15s ease,
                    box-shadow .15s ease;
    }

    .form-control:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, .12);
    }

    .field-error {
        display: block;
        margin-top: 5px;
        color: #dc2626;
        font-size: 13px;
    }

    .login-error {
        margin-bottom: 20px;
        padding: 13px 15px;
        border-radius: 9px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #b91c1c;
        font-size: 14px;
    }

    .login-error ul {
        margin: 0;
        padding-left: 18px;
    }

    .remember-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        margin-bottom: 24px;
        font-size: 14px;
    }

    .remember-label {
        display: flex;
        align-items: center;
        gap: 7px;
        cursor: pointer;
    }

    .remember-label input {
        width: 16px;
        height: 16px;
    }

    .remember-row a {
        color: #2563eb;
        text-decoration: none;
    }

    .remember-row a:hover {
        text-decoration: underline;
    }

    .btn-login,
    .btn-force-login {
        width: 100%;
        min-height: 50px;
        border: none;
        border-radius: 9px;
        color: #ffffff;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: transform .1s ease,
                    opacity .15s ease;
    }

    .btn-login {
        background: #2563eb;
    }

    .btn-force-login {
        background: #dc2626;
        padding: 12px 16px;
    }

    .btn-login:hover,
    .btn-force-login:hover {
        opacity: .92;
    }

    .btn-login:active,
    .btn-force-login:active {
        transform: translateY(1px);
    }

    .session-warning {
        display: flex;
        gap: 14px;
        padding: 17px;
        margin-bottom: 22px;
        border-radius: 12px;
        background: #fff7ed;
        border: 1px solid #fed7aa;
    }

    .session-warning-icon {
        flex: 0 0 auto;
        font-size: 25px;
    }

    .session-warning-content {
        min-width: 0;
    }

    .session-warning-content h3 {
        margin: 0 0 7px;
        color: #9a3412;
        font-size: 17px;
    }

    .session-warning-content p {
        margin: 5px 0;
        color: #7c2d12;
        font-size: 14px;
        line-height: 1.5;
    }

    .last-seen {
        margin-top: 12px;
        padding-top: 10px;
        border-top: 1px solid #fed7aa;
        color: #92400e;
        font-size: 12px;
    }

    .session-security-note {
        margin-top: 12px;
        padding: 11px;
        border-radius: 7px;
        background: #ffffff;
        color: #7c2d12;
        font-size: 13px;
        line-height: 1.5;
    }

    .force-warning {
        margin-top: 11px;
        text-align: center;
        color: #7f1d1d;
        font-size: 12px;
        line-height: 1.5;
    }

    .login-footer {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin-top: 28px;
        padding-top: 18px;
        border-top: 1px solid #e5e7eb;
        color: #9ca3af;
        font-size: 11px;
    }

    @@media (max-width: 520px) {

        .login-page {
            padding: 20px 12px;
        }

        .login-card {
            padding: 26px 20px;
            border-radius: 12px;
        }

        .login-header h1 {
            font-size: 28px;
        }

        .remember-row {
            align-items: flex-start;
            flex-direction: column;
        }

        .login-footer {
            flex-direction: column;
            text-align: center;
        }
    }

</style>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}