@using Microsoft.JSInterop
@implements IAsyncDisposable

@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

@code {
    private DotNetObjectReference<ApplicationRealtimeRefreshListener>? _dotNetRef;
    private bool _registered;
    private bool _disposed;
    private long _lastRefreshTicks;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed)
            return;

        try
        {
            _dotNetRef =
                DotNetObjectReference.Create(this);

            await JSRuntime.InvokeVoidAsync(
                "attendanceRefresh.registerApplication",
                _dotNetRef);

            _registered = true;
        }
        catch
        {
            // Realtime refresh is an enhancement. It must never break
            // normal page rendering when the circuit is unavailable.
        }
    }

    [JSInvokable]
    public async Task ApplicationDataChanged(object? data = null)
    {
        // ... (existing code)
    }

    [JSInvokable]
    public async Task SessionEnded(object? data = null)
    {
        if (_disposed) return;

        // If the server broadcasts SessionEnded, it means a newer login replaced this one
        // or the session was explicitly terminated.
        await InvokeAsync(() =>
        {
            // Force a hard reload to trigger the identity redirect to login
            Navigation.NavigateTo("/Account/Login", true);
            return Task.CompletedTask;
        });
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
            return;

        _disposed = true;

        try
        {
            if (_registered && _dotNetRef != null)
            {
                await JSRuntime.InvokeVoidAsync(
                    "attendanceRefresh.unregisterApplication",
                    _dotNetRef);
            }
        }
        catch
        {
            // Circuit may already be disconnected.
        }
        finally
        {
            _registered = false;
            _dotNetRef?.Dispose();
            _dotNetRef = null;
        }
    }
}
