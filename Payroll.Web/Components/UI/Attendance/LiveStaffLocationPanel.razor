    private Guid? selectedPlaybackSessionId;

    private string playbackStatus = "Ready";

    private int playbackIndex;

    private CancellationTokenSource? playbackStateCts;


    private int liveCount =>
        locations.Count(
            x => GetLocationStatus(x) == LocationStatus.Live);

    private int staleCount =>
        locations.Count(
            x => GetLocationStatus(x) == LocationStatus.Stale);

    private int offlineCount =>
        Math.Max(
            0,
            employees.Count - liveCount - staleCount);

    private IReadOnlyList<EmployeeLocationHistory> PlaybackPoints =>
        selectedPlaybackSessionId.HasValue
            ? selectedHistory
                .Where(x => x.SessionId == selectedPlaybackSessionId.Value)
                .OrderBy(x => x.RecordedAtUtc)
                .ToList()
            : selectedHistory;

    private bool CanPlayback =>
        PlaybackPoints.Count > 0;

    private int PlaybackIndex =>
     Math.Max(
         0,
         Math.Min(
             playbackIndex,
             Math.Max(0, PlaybackPoints.Count - 1)));

    private int PlaybackDisplayIndex =>
