    private async Task PlayHistory()
    {
        if (!CanPlayback || selectedEmployeeId <= 0)
            return;

        if (PlaybackIndex >= PlaybackPoints.Count - 1)
            playbackIndex = 0;

        playbackStatus = "Playing";

        await JSRuntime.InvokeVoidAsync(
            "startAdminHistoryPlayback",
            mapId,
            PlaybackPoints,
            SelectedEmployeeName,
            playbackSpeed,
