    private static string GetAccuracyLabel(double meters)
    {
        if (meters <= 0) return "Unknown";
        if (meters <= 20) return "Excellent";
        if (meters <= 50) return "Good";
        if (meters <= 100) return "Fair";
        if (meters <= 200) return "Poor";
        return "Very Poor";
    }

    private static string GetAccuracyClass(double meters)
    {
        if (meters <= 0) return "unknown";
        if (meters <= 20) return "excellent";
        if (meters <= 50) return "good";
        if (meters <= 100) return "fair";
        if (meters <= 200) return "poor";
        return "very-poor";
    }



    private double HistoryAverageAccuracy =>
        selectedHistory.Count == 0
            ? 0
            : selectedHistory.Where(x => x.AccuracyMeters > 0).Select(x => x.AccuracyMeters).DefaultIfEmpty().Average();

    private double HistoryWorstAccuracy =>
        selectedHistory.Count == 0
            ? 0
            : selectedHistory.Max(x => x.AccuracyMeters);

    private int HistoryPoorAccuracyCount =>
        selectedHistory.Count(x => x.AccuracyMeters > 100);

    private int HistoryOutsideRangeCount =>
        selectedHistory.Count(x => !x.IsWithinAllowedRadius);

    private int HistorySessionCount =>
        HistorySessions.Count;

    private List<SessionSummary> HistorySessions =>
        selectedHistory
            .GroupBy(x => x.SessionId)
            .Select(g =>
            {
                var points = g.OrderBy(x => x.RecordedAtUtc).ToList();
                double travel = 0;
                for (int i = 1; i < points.Count; i++)
                    travel += CalculateDistance(points[i - 1].Latitude, points[i - 1].Longitude, points[i].Latitude, points[i].Longitude);
                var accuracies = points.Where(x => x.AccuracyMeters > 0).Select(x => x.AccuracyMeters).ToList();
                return new SessionSummary
                {
                    SessionId = g.Key,
                    StartUtc = points.First().RecordedAtUtc,
                    EndUtc = points.Last().RecordedAtUtc,
                    PointCount = points.Count,
                    TravelMeters = travel,
                    AverageAccuracy = accuracies.Count == 0 ? 0 : accuracies.Average()
                };
            })
            .OrderByDescending(x => x.StartUtc)
            .ToList();

