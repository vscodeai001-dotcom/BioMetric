    private IReadOnlyList<JourneyEventView> HistoryJourneyEvents
    {
        get
        {
            var events = new List<JourneyEventView>();
            if (selectedHistory.Count == 0)
                return events;

            events.Add(new JourneyEventView
            {
                Index = 0,
                Time = ToLocalTime(selectedHistory[0].RecordedAtUtc).ToString("HH:mm:ss"),
                Label = "Journey started",
                Detail = $"{selectedHistory[0].Latitude:F5}, {selectedHistory[0].Longitude:F5}"
            });

            for (var i = 1; i < selectedHistory.Count && events.Count < 8; i++)
            {
                var previous = selectedHistory[i - 1];
                var current = selectedHistory[i];
                var gap = current.RecordedAtUtc - previous.RecordedAtUtc;

                if (current.IsWithinAllowedRadius != previous.IsWithinAllowedRadius)
                {
                    events.Add(new JourneyEventView
                    {
                        Index = i,
                        Time = ToLocalTime(current.RecordedAtUtc).ToString("HH:mm:ss"),
                        Label = current.IsWithinAllowedRadius ? "Entered geofence" : "Left geofence",
                        Detail = FormatDistance(current.DistanceFromOfficeMeters)
                    });
                }
                else if (gap.TotalMinutes >= 3)
                {
                    events.Add(new JourneyEventView
                    {
                        Index = i,
                        Time = ToLocalTime(current.RecordedAtUtc).ToString("HH:mm:ss"),
                        Label = "Stop detected",
                        Detail = $"{Math.Round(gap.TotalMinutes)} min pause"
                    });
                }
            }

            if (selectedHistory.Count > 1)
            {
                events.Add(new JourneyEventView
                {
                    Index = selectedHistory.Count - 1,
                    Time = ToLocalTime(selectedHistory[^1].RecordedAtUtc).ToString("HH:mm:ss"),
                    Label = "Journey ended",
                    Detail = $"{selectedHistory[^1].Latitude:F5}, {selectedHistory[^1].Longitude:F5}"
                });
            }

            return events;
        }
    }

    private static double CalculateDistance(
        double lat1,
        double lon1,
        double lat2,
        double lon2)
    {
        const double earthRadius =
            6371000;

        var r1 =
            lat1 * Math.PI / 180;

        var r2 =
            lat2 * Math.PI / 180;

        var dLat =
            (lat2 - lat1) *
            Math.PI / 180;

        var dLon =
            (lon2 - lon1) *
            Math.PI / 180;

        var a =
            Math.Sin(dLat / 2) *
            Math.Sin(dLat / 2) +
            Math.Cos(r1) *
            Math.Cos(r2) *
            Math.Sin(dLon / 2) *
            Math.Sin(dLon / 2);

        var c =
            2 *
            Math.Atan2(
                Math.Sqrt(a),
                Math.Sqrt(1 - a));

        return earthRadius * c;
    }


