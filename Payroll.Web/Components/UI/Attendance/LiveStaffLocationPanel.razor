    private string GetHistorySessionStatus(Guid sessionId)
    {
        if (sessionId == Guid.Empty)
            return "Ended";

        if (!gpsSessionLookup.TryGetValue(
                sessionId,
                out var session))
        {
            return "Ended";
        }

        /*
         * EndedAtUtc == null means the GPS session
         * has not been explicitly closed yet.
         */
        return session.EndedAtUtc.HasValue
            ? "Ended"
            : "Active";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadEmployees();

        /*
         * Initial snapshot only.
         *
         * After this, GPS updates arrive through SignalR.
         */
        await RefreshLocations();

        /*
         * Keep the existing timer only for:
         *
         * 1. Playback state
         * 2. LIVE → STALE → OFFLINE UI aging
         *
         * It MUST NOT call RefreshLocations().
         */
        refreshCts =
            new CancellationTokenSource();

        _ =
            AutoRefresh(
                refreshCts.Token);
    }


    private async Task LoadEmployees()
    {
