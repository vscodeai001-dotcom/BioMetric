        await StopPlayback();

        selectedEmployeeId = employeeId;

        historyDate = DateTime.Today;
        punchAuditDate = historyDate;

        selectedPunchAudit = null;

        playbackIndex = 0;
        playbackStatus = "Ready";

        await LoadSelectedEmployeeHistory();

