    private static TimeSpan GetSessionDuration(
        LiveEmployeeLocation location)
    {
        var duration =
            DateTime.UtcNow -
            location.SessionStartedUtc;

        return duration < TimeSpan.Zero
            ? TimeSpan.Zero
            : duration;
    }


    private static string FormatDuration(
        TimeSpan duration)
    {
        if (duration.TotalDays >= 1)
        {
            return
                $"{(int)duration.TotalDays}d " +
                $"{duration.Hours:00}h " +
                $"{duration.Minutes:00}m";
        }

        if (duration.TotalHours >= 1)
        {
            return
                $"{(int)duration.TotalHours}h " +
                $"{duration.Minutes:00}m";
        }

        return
            $"{duration.Minutes:00}m " +
            $"{duration.Seconds:00}s";
    }


