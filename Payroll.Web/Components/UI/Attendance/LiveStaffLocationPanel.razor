    private async Task PauseHistory()
    {
        if (!CanPlayback)
            return;

        playbackStatus =
            "Paused";

        await JSRuntime.InvokeVoidAsync(
            "pauseAdminHistoryPlayback",
            mapId);

        await InvokeAsync(
            StateHasChanged);
    }


    private async Task ResetHistory()
    {
        if (!CanPlayback)
            return;

        await JSRuntime.InvokeVoidAsync(
            "resetAdminHistoryPlayback",
            mapId);

        playbackIndex = 0;

        playbackStatus =
            "Ready";

        await InvokeAsync(
            StateHasChanged);
    }


    private bool IsHistoryPointActive(int historyIndex)
    {
        if (historyIndex < 0 || historyIndex >= selectedHistory.Count || !CanPlayback)
            return false;

        var point = selectedHistory[historyIndex];

        if (selectedPlaybackSessionId.HasValue &&
            point.SessionId != selectedPlaybackSessionId.Value)
            return false;

        var playbackPoint = PlaybackPoints[PlaybackIndex];
        return playbackPoint.Id == point.Id;
    }

    private async Task SelectHistoryPoint(int index)
    {
        if (index < 0 || index >= selectedHistory.Count)
            return;

        var point = selectedHistory[index];

        // If a session is selected, clicking a point from another session
        // automatically switches playback to that session.
        if (selectedPlaybackSessionId.HasValue &&
            point.SessionId != selectedPlaybackSessionId.Value)
        {
            await SelectPlaybackSession(point.SessionId);
            return;
        }

        var playbackIndexForPoint = selectedPlaybackSessionId.HasValue
            ? PlaybackPoints
                .Select((x, i) => new { x, i })
                .FirstOrDefault(x => x.x.Id == point.Id)?.i ?? -1
            : index;

        if (playbackIndexForPoint < 0)
            return;

        playbackIndex = playbackIndexForPoint;
        playbackStatus = "Paused";

        try
        {
            await JSRuntime.InvokeVoidAsync("pauseAdminHistoryPlayback", mapId);
            await JSRuntime.InvokeVoidAsync("seekAdminHistoryPlayback", mapId, playbackIndex);
        }
        catch { }

        await InvokeAsync(StateHasChanged);
    }


    private async Task SeekHistoryFromSlider(ChangeEventArgs e)
    {
        if (!CanPlayback)
            return;

        if (!int.TryParse(e.Value?.ToString(), out var index))
            return;

        index = Math.Max(0, Math.Min(PlaybackPoints.Count - 1, index));
        playbackIndex = index;

        await JSRuntime.InvokeVoidAsync(
            "seekAdminHistoryPlayback",
            mapId,
            index);

        playbackStatus =
            "Paused";

        await InvokeAsync(
            StateHasChanged);
    }


    private async Task ChangePlaybackSpeed(
        ChangeEventArgs e)
    {
        if (!double.TryParse(
            e.Value?.ToString(),
            out var speed))
            return;

        playbackSpeed =
            Math.Max(.25, speed);

        if (CanPlayback)
        {
            await JSRuntime.InvokeVoidAsync(
                "setAdminHistoryPlaybackSpeed",
                mapId,
                playbackSpeed);
        }
    }


    private void StartPlaybackPolling()
    {
        if (playbackStateCts != null)
            return;

        playbackStateCts =
            new CancellationTokenSource();

        _ =
            PollPlaybackLoop(
                playbackStateCts.Token);
    }


    private async Task PollPlaybackLoop(
        CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(
                    400,
                    token);

                if (token.IsCancellationRequested)
                    break;

                await PollPlaybackState();
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Playback polling failed: {ex}");
        }
    }


    private async Task PollPlaybackState()
    {
        if (!CanPlayback)
            return;

        try
        {
            var state =
                await JSRuntime.InvokeAsync<PlaybackState?>(
                    "getAdminHistoryPlaybackState",
                    mapId);

            if (state == null)
                return;

            var newIndex =
                Math.Max(
                    0,
                    Math.Min(
                        PlaybackPoints.Count - 1,
                        state.Index));

            var changed =
                playbackIndex != newIndex;

            playbackIndex =
                newIndex;

            if (state.Completed)
            {
                playbackStatus =
                    "Completed";

                StopPlaybackPolling();
            }
            else if (state.Playing)
            {
                playbackStatus =
                    "Playing";
            }

            if (changed)
            {
                await InvokeAsync(
                    StateHasChanged);
            }
        }
        catch
        {
            // Browser circuit may be closing.
        }
    }


    private void StopPlaybackPolling()
    {
        try
        {
            playbackStateCts?.Cancel();
        }
        catch
        {
        }

        playbackStateCts?.Dispose();

        playbackStateCts = null;
    }


    private async Task StopPlayback()
    {
        StopPlaybackPolling();

        try
        {
            await JSRuntime.InvokeVoidAsync(
                "stopAdminHistoryPlayback",
                mapId);
            await JSRuntime.InvokeVoidAsync(
                "stopAdminWorkforceJourneyReplay",
                mapId);
        }
        catch
        {
        }

        playbackIndex = 0;

        playbackStatus =
            "Ready";
    }


