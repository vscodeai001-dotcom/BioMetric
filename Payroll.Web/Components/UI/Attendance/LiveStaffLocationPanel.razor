    private LocationStatus GetLocationStatus(
        LiveEmployeeLocation? location)
    {
        if (location == null)
            return LocationStatus.Offline;

        var age =
            DateTime.UtcNow -
            location.LastUpdatedUtc;

        // The LiveLocationStore is the source of truth for the active
        // employee GPS session. Its thresholds are intentionally long so
        // a browser background/sleep throttle does not turn a still-logged-in
        // employee into Offline merely because a fresh GPS point was delayed.
        // The actual LastUpdated time is still displayed separately.
        if (age <= TimeSpan.FromSeconds(LiveLocationStore.LiveTimeoutSeconds))
            return LocationStatus.Live;

        if (age <= TimeSpan.FromSeconds(LiveLocationStore.StaleTimeoutSeconds))
            return LocationStatus.Stale;

        return LocationStatus.Offline;
    }


