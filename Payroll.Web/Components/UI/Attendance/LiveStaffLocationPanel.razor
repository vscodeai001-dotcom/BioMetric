    private LocationStatus GetLocationStatus(
        LiveEmployeeLocation? location)
    {
        if (location == null)
            return LocationStatus.Offline;

        var age =
            DateTime.UtcNow -
            location.LastUpdatedUtc;

        if (age <=
            TimeSpan.FromSeconds(30))
            return LocationStatus.Live;

        if (age <=
            TimeSpan.FromMinutes(2))
            return LocationStatus.Stale;

        return LocationStatus.Offline;
    }


