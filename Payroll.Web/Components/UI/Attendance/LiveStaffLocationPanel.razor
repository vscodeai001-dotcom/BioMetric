    private static DateTime ToLocalTime(DateTime utc)
    {
        var utcValue = DateTime.SpecifyKind(
            utc,
            DateTimeKind.Utc);

        TimeZoneInfo indiaTimeZone;

        try
        {
            indiaTimeZone =
                TimeZoneInfo.FindSystemTimeZoneById("Asia/Kolkata");
        }
        catch (TimeZoneNotFoundException)
        {
            indiaTimeZone =
                TimeZoneInfo.FindSystemTimeZoneById("India Standard Time");
        }

        return TimeZoneInfo.ConvertTimeFromUtc(
            utcValue,
            indiaTimeZone);
    }



    public async ValueTask DisposeAsync()
    {
        if (disposed)
            return;

        disposed = true;

        /*
         * Stop UI timer.
         */
        try
        {
            refreshCts?.Cancel();
        }
        catch
        {
        }

        try
        {
            refreshCts?.Dispose();
        }
        catch
        {
        }

        refreshCts = null;

        /*
         * Stop playback polling.
         */
        try
        {
            playbackStateCts?.Cancel();
        }
        catch
        {
        }

        try
        {
            playbackStateCts?.Dispose();
        }
        catch
        {
        }

        playbackStateCts = null;

        /*
         * Unregister this component from SignalR.
         */
        if (liveLocationSignalRReference != null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync(
                    "attendanceRefresh.unregister",
                    liveLocationSignalRReference);
            }
            catch
            {
            }

            try
            {
                await JSRuntime.InvokeVoidAsync(
                    "attendanceRefresh.unregisterLocationHealth",
                    liveLocationSignalRReference);
            }
            catch { }

            liveLocationSignalRReference.Dispose();

            liveLocationSignalRReference = null;
        }

        /*
         * Stop historical playback.
         */
        try
        {
            await JSRuntime.InvokeVoidAsync(
                "stopAdminHistoryPlayback",
                mapId);
        }
        catch
        {
        }

        /*
         * Destroy only this admin map.
         */
        try
        {
            await JSRuntime.InvokeVoidAsync(
                "destroyAdminLiveStaffMap",
                mapId);
        }
        catch
        {
        }
    }


