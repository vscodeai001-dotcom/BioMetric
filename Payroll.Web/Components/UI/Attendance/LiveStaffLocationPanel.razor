@using global::Payroll.Web.Services
@using global::Payroll.Shared.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using System.Text.Json
@implements IAsyncDisposable

@inject IJSRuntime JSRuntime
@inject LocationHistoryService LocationHistoryService
@inject IDbContextFactory<AppDbContext> DbFactory

<div class="live-staff-card card border-0 shadow-sm mb-4 @(workforceReplayActive ? "workforce-replay-active" : "")">

    <!-- ============================================================
         LIVE STAFF HEADER
         ============================================================ -->

    <div class="live-staff-header d-flex justify-content-between align-items-center">

        <div>
            <h5 class="fw-bold mb-1">
                <i class="bi bi-geo-alt-fill text-primary me-2"></i>
                Live Staff Locations
            </h5>

            <small class="text-muted">
                Current employee location from active GPS sessions
            </small>
        </div>

        <div class="d-flex align-items-center gap-2">

            <span class="live-count">
                <span class="live-count-dot"></span>
                @liveCount Live / @employees.Count
            </span>

            <button type="button"
                    class="btn btn-outline-primary btn-sm"
                    @onclick="RefreshLocations"
                    disabled="@isRefreshing">

                <i class="bi bi-arrow-clockwise @(isRefreshing ? "spin" : "")"></i>

                <span class="d-none d-md-inline ms-1">
                    Refresh
                </span>

            </button>

        </div>

    </div>


    <!-- ============================================================
         LIVE MAP + STAFF LIST
         ============================================================ -->

    <div class="live-staff-body @(selectedEmployeeId > 0 ? "has-selection" : "")">

        <div class="admin-map-wrapper">

            <div id="@mapId"
                 class="admin-live-map">
            </div>

            @if (liveCount == 0)
            {
                <div class="map-empty-overlay">
                    <i class="bi bi-broadcast-pin display-6 text-muted"></i>
                    <span>No live staff locations</span>
                    <small>Live employee locations will appear automatically.</small>
                </div>
            }

            <div class="map-live-legend">
                <span><i class="legend-dot within"></i> Within range</span>
                <span><i class="legend-dot outside"></i> Outside range</span>
            </div>

            @if (workforceReplayActive)
            {
                <button type="button"
                        class="workforce-replay-exit"
                        @onclick="ExitWorkforceJourneyReplay"
                        aria-label="Exit journey replay and return to live location view">
                    <i class="bi bi-x-lg"></i>
                    <span>Exit Replay</span>
                </button>
            }

        </div>

        @if (selectedEmployeeId > 0)
        {
            var selectedEmployee = employees.FirstOrDefault(e => e.EmployeeID == selectedEmployeeId);
            var selectedLocation = GetLocation(selectedEmployeeId);

            if (selectedEmployee != null)
            {
                <aside class="selected-live-card">
                    <div class="selected-live-card-header">
                        <div class="selected-identity">
                            <div class="premium-avatar @GetAvatarClass(selectedLocation != null ? GetLocationStatus(selectedLocation) : LocationStatus.Offline)">
                                @GetInitials(selectedEmployee.Name)
                                <span class="avatar-status-dot"></span>
                            </div>
                            <div class="selected-identity-text">
                                <strong>@selectedEmployee.Name</strong>
                                <span>Live location tracking</span>
                            </div>
                        </div>
                        <button type="button" class="selected-close" @onclick="() => SelectEmployee(selectedEmployeeId)" aria-label="Close employee details">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>

                    @if (selectedLocation != null)
                    {
                        var selectedStatus = GetLocationStatus(selectedLocation);
                        <div class="selected-status-row">
                            <span class="selected-status @GetStatusClass(selectedStatus)">
                                <i class="bi bi-record-fill"></i> @GetStatusText(selectedStatus)
                            </span>
                            <span class="selected-updated">
                                Updated @ToLocalTime(selectedLocation.LastUpdatedUtc).ToString("HH:mm:ss")
                            </span>
                        </div>

                        <div class="selected-metrics">
                            <div class="selected-metric primary">
                                <span><i class="bi bi-signpost-2-fill"></i> Route distance</span>
                                <strong data-selected-route-distance="@selectedEmployee.EmployeeID">@FormatDistance(selectedLocation.DistanceMeters)</strong>
                            </div>
                            <div class="selected-metric">
                                <span><i class="bi bi-bullseye"></i> Geofence</span>
                                <strong class="@(selectedLocation.IsWithinAllowedRadius ? "text-success" : "text-danger")">
                                    @(selectedLocation.IsWithinAllowedRadius ? "Within range" : "Outside range")
                                </strong>
                            </div>
                            <div class="selected-metric">
                                <span><i class="bi bi-crosshair"></i> GPS accuracy</span>
                                <strong>@FormatAccuracy(selectedLocation.AccuracyMeters)</strong>
                            </div>
                            <div class="selected-metric">
                                <span><i class="bi bi-hourglass-split"></i> Tracking</span>
                                <strong>@FormatDuration(GetSessionDuration(selectedLocation))</strong>
                            </div>
                            <div class="selected-metric">
                                <span><i class="bi bi-broadcast-pin"></i> Last update</span>
                                <strong>@ToLocalTime(selectedLocation.LastUpdatedUtc).ToString("HH:mm:ss")</strong>
                            </div>
                            <div class="selected-metric">
                                <span><i class="bi bi-rulers"></i> Allowed radius</span>
                                <strong>@selectedLocation.AllowedRadiusMeters m</strong>
                            </div>
                        </div>

                        <div class="selected-coordinates">
                            <div><span>Latitude</span><strong>@selectedLocation.Latitude.ToString("F6")</strong></div>
                            <div><span>Longitude</span><strong>@selectedLocation.Longitude.ToString("F6")</strong></div>
                        </div>

                        <button type="button" class="selected-action" @onclick="() => SelectEmployee(selectedEmployeeId)">
                            <i class="bi bi-chevron-up"></i> Collapse details
                        </button>
                    }
                    else
                    {
                        <div class="selected-offline">
                            <i class="bi bi-broadcast"></i>
                            <strong>GPS session unavailable</strong>
                            <span>The employee is not currently sending a live location.</span>
                        </div>
                    }
                </aside>
            }
        }

    </div>

    <!-- ============================================================
         FOOTER
         ============================================================ -->

    <div class="live-staff-footer">

        <span>
            <i class="bi bi-clock me-1"></i>
            @GetFooterText()
        </span>

        <span>
            @liveCount live · @staleCount stale · @offlineCount offline
        </span>

    </div>

</div>


<!-- ================================================================
     SELECTED EMPLOYEE DETAILS
     ================================================================ -->
@if (selectedEmployeeId > 0)
{
    var selectedEmployee =
        employees.FirstOrDefault(e => e.EmployeeID == selectedEmployeeId);

    var selectedLocation =
        GetLocation(selectedEmployeeId);

    if (selectedEmployee != null)
    {
        <div class="live-staff-details card border-0 shadow-sm mb-4">

            <div class="live-details-header d-flex justify-content-between align-items-center">

                <div>

                    <h6 class="fw-bold mb-1">

                        <i class="bi bi-person-badge text-primary me-2"></i>

                        @selectedEmployee.Name

                    </h6>

                    <small class="text-muted">

                        @(selectedLocation != null
                                        ? "Live tracking details"
                                        : "Employee location details")

            </small>

                </div>

        @if (selectedLocation != null)
                {
                    var selectedStatus =
                    GetLocationStatus(selectedLocation);

                    <span class="staff-live-state @GetStatusClass(selectedStatus)">
                        @GetStatusText(selectedStatus)
                    </span>
                }
                else
                {
                    <span class="staff-live-state offline">
                        Offline
                    </span>
                }

            </div>


            @if (selectedLocation != null)
            {
                <div class="live-details-grid">

                    <div class="live-detail-box">
                        <span>Tracking started</span>
                        <strong>
                            @(ToLocalTime(selectedLocation.SessionStartedUtc)
                                            .ToString("dd MMM yyyy HH:mm:ss"))
                                                                          </strong>
                                                                      </div>

                    <div class="live-detail-box">
                        <span>Tracking duration</span>
                        <strong>
                            @FormatDuration(GetSessionDuration(selectedLocation))
                        </strong>
                    </div>

                    <div class="live-detail-box">
                        <span>Last GPS update</span>
                        <strong>
                            @(ToLocalTime(selectedLocation.LastUpdatedUtc)
                                            .ToString("HH:mm:ss"))
            </strong>
        </div>

                    <div class="live-detail-box">
                        <span>Distance from office</span>
                        <strong>
                            @FormatDistance(selectedLocation.DistanceMeters)
                        </strong>
                    </div>
                    <div class="live-detail-box">
                        <span>GPS accuracy</span>
                        <strong>
                            @FormatAccuracy(selectedLocation.AccuracyMeters)
                        </strong>
                    </div>
                    <div class="live-detail-box">
                        <span>Allowed radius</span>
                        <strong>
                            @selectedLocation.AllowedRadiusMeters m
                        </strong>
                    </div>

                    <div class="live-detail-box">
                        <span>Geofence status</span>

                        <strong class="@(selectedLocation.IsWithinAllowedRadius
                                                                                                                                                                                            ? "text-success"
                                                                                                                                                                                            : "text-danger")">

                            @(selectedLocation.IsWithinAllowedRadius
                                            ? "Within allowed range"
                                            : "Outside allowed range")

            </strong>
        </div>

                    <div class="live-detail-box">
                        <span>Latitude</span>

                        <strong>
                            @selectedLocation.Latitude.ToString("F6")
                        </strong>
                    </div>

                    <div class="live-detail-box">
                        <span>Longitude</span>

                        <strong>
                            @selectedLocation.Longitude.ToString("F6")
                        </strong>
                    </div>

                </div>
        }
            else
            {
                <div class="offline-details-message">

                    <i class="bi bi-geo-alt"></i>

                    <span>
                        This employee does not currently have an active GPS session.
                    </span>

                </div>
            }

        </div>


        <!-- ============================================================
             GEO PUNCH AUDIT
             ============================================================ -->
        <div class="geo-punch-audit-card card border-0 shadow-sm mb-4">
            <div class="geo-punch-audit-header d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold mb-1">
                        <i class="bi bi-shield-check text-primary me-2"></i>
                        @selectedEmployee.Name Punch Audit
                    </h5>
                    <small class="text-muted">GPS validation and attendance punch audit</small>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <button type="button" class="btn btn-outline-primary btn-sm"
                            title="Previous day" aria-label="Previous day"
                            @onclick="() => ChangeAuditDateByDays(-1)"
                            disabled="@punchAuditLoading">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <input type="date" class="form-control form-control-sm history-date-input"
                           value="@punchAuditDate.ToString("yyyy-MM-dd")"
                           @onchange="ChangePunchAuditDate" />
                    <button type="button" class="btn btn-outline-primary btn-sm"
                            title="Next day" aria-label="Next day"
                            @onclick="() => ChangeAuditDateByDays(1)"
                            disabled="@punchAuditLoading">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-sm"
                            @onclick="LoadSelectedEmployeePunchAudits"
                            disabled="@punchAuditLoading">
                        <i class="bi bi-arrow-clockwise @(punchAuditLoading ? "spin" : "")"></i>
                        <span class="d-none d-md-inline ms-1">Refresh</span>
                    </button>
                </div>
            </div>
            @if (punchAuditLoading)
            {
                <div class="history-loading">
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    Loading punch audit...
                </div>
            }
            else if (selectedPunchAudits.Count == 0)
            {
                <div class="history-empty">
                    <i class="bi bi-shield-x"></i>
                    <strong>No GPS punch audit records</strong>
                    <span>No punch audit records were found for @punchAuditDate.ToString("dd MMM yyyy").</span>
                </div>
            }
            else
            {
                <div class="geo-punch-audit-summary">
                    <div><small>TOTAL</small><strong>@selectedPunchAudits.Count</strong></div>
                    <div><small>SUCCESS</small><strong class="text-success">@selectedPunchAudits.Count(x => x.Success)</strong></div>
                    <div><small>FAILED</small><strong class="text-danger">@selectedPunchAudits.Count(x => !x.Success)</strong></div>
                    <div><small>OUTSIDE RANGE</small><strong class="text-danger">@selectedPunchAudits.Count(x => !x.IsWithinAllowedRadius)</strong></div>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover geo-punch-audit-table mb-0">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Result</th>
                                <th>Accuracy</th>
                                <th>Distance</th>
                                <th>Allowed</th>
                                <th>Geofence</th>
                                <th>Message</th>
                                <th>Session</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var audit in selectedPunchAudits)
                            {
                                <tr class="geo-punch-audit-row" @onclick="() => OpenPunchAudit(audit)" title="Click to view punch details">
                                    <td class="fw-semibold">@ToLocalTime(audit.PunchTimeUtc).ToString("HH:mm:ss")</td>
                                    <td>
                                        @if (audit.Success)
                                        {
                                            <span class="geo-audit-success"><i class="bi bi-check-circle-fill me-1"></i>Success</span>
                                        }
                                        else
                                        {
                                            <span class="geo-audit-failed"><i class="bi bi-x-circle-fill me-1"></i>Failed</span>
                                        }
                                    </td>
                                    <td><span class="gps-accuracy-badge @GetAccuracyClass(audit.AccuracyMeters)">@GetAccuracyLabel(audit.AccuracyMeters) <small>@FormatAccuracy(audit.AccuracyMeters)</small></span></td>
                                    <td>@FormatDistance(audit.DistanceFromOfficeMeters)</td>
                                    <td>@audit.AllowedRadiusMeters m</td>
                                    <td>
                                        @if (audit.IsWithinAllowedRadius)
                                        {
                                            <span class="geo-audit-within"><i class="bi bi-geo-alt-fill me-1"></i>Within</span>
                                        }
                                        else
                                        {
                                            <span class="geo-audit-outside"><i class="bi bi-geo-alt-fill me-1"></i>Outside</span>
                                        }
                                    </td>
                                    <td class="geo-audit-message" title="@audit.ResultMessage">@audit.ResultMessage</td>
                                    <td>
                                        @if (audit.SessionId.HasValue)
                                        {
                                            <span title="@audit.SessionId.Value">@audit.SessionId.Value.ToString("N").Substring(0, 8)</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @if (selectedPunchAudit != null)
        {
            <div class="geo-audit-modal-backdrop" @onclick="ClosePunchAudit">
                <div class="geo-audit-modal card border-0 shadow-lg" @onclick:stopPropagation="true">
                    <div class="geo-audit-modal-header d-flex justify-content-between align-items-center">
                        <div><h5 class="fw-bold mb-1"><i class="bi bi-shield-check text-primary me-2"></i>Punch Audit Details</h5><small class="text-muted">@selectedEmployee.Name · @ToLocalTime(selectedPunchAudit.PunchTimeUtc).ToString("dd MMM yyyy HH:mm:ss")</small></div>
                        <button type="button" class="btn btn-sm btn-light" @onclick="ClosePunchAudit"><i class="bi bi-x-lg"></i></button>
                    </div>
                    <div class="geo-audit-modal-body">
                        <div class="geo-audit-result-banner @(selectedPunchAudit.Success ? "success" : "failed")"><i class="bi @(selectedPunchAudit.Success ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i><div><strong>@(selectedPunchAudit.Success ? "Punch Accepted" : "Punch Rejected")</strong><span>@selectedPunchAudit.ResultMessage</span></div></div>
                        <div class="geo-audit-detail-grid">
                            <div><small>GPS ACCURACY</small><strong class="@GetAccuracyClass(selectedPunchAudit.AccuracyMeters)">@GetAccuracyLabel(selectedPunchAudit.AccuracyMeters)</strong><span>@FormatAccuracy(selectedPunchAudit.AccuracyMeters)</span></div>
                            <div><small>DISTANCE FROM OFFICE</small><strong>@FormatDistance(selectedPunchAudit.DistanceFromOfficeMeters)</strong><span>Allowed @selectedPunchAudit.AllowedRadiusMeters m</span></div>
                            <div><small>GEOFENCE</small><strong class="@(selectedPunchAudit.IsWithinAllowedRadius ? "text-success" : "text-danger")">@(selectedPunchAudit.IsWithinAllowedRadius ? "Within range" : "Outside range")</strong><span>@FormatDistance(selectedPunchAudit.DistanceFromOfficeMeters) / @selectedPunchAudit.AllowedRadiusMeters m</span></div>
                            <div><small>SOURCE</small><strong>@selectedPunchAudit.Source</strong><span>Attendance ID: @(selectedPunchAudit.AttendanceLogId?.ToString() ?? "-")</span></div>
                            <div><small>LATITUDE</small><strong>@selectedPunchAudit.Latitude.ToString("F6")</strong><span>GPS coordinate</span></div>
                            <div><small>LONGITUDE</small><strong>@selectedPunchAudit.Longitude.ToString("F6")</strong><span>GPS coordinate</span></div>
                            <div class="geo-audit-detail-wide"><small>SESSION ID</small><strong>@(selectedPunchAudit.SessionId?.ToString() ?? "-")</strong></div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- ============================================================
             LOCATION HISTORY
             ============================================================ -->

        <div class="location-history-card card border-0 shadow-sm mb-4">

            <div class="location-history-header d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="fw-bold mb-1">

                        <i class="bi bi-clock-history text-primary me-2"></i>

                        @selectedEmployee.Name Location History

                    </h5>

                    <small class="text-muted">
                        GPS location history recorded for the selected date
                    </small>

                </div>

                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <button type="button"
                            class="btn btn-outline-primary btn-sm"
                            title="Previous day" aria-label="Previous day"
                            @onclick="() => ChangeHistoryDateByDays(-1)"
                            disabled="@historyLoading">
                        <i class="bi bi-chevron-left"></i>
                    </button>

                    <input type="date"
                           class="form-control form-control-sm history-date-input"
                           value="@historyDate.ToString("yyyy-MM-dd")"
                           @onchange="ChangeHistoryDate" />

                    <button type="button"
                            class="btn btn-outline-primary btn-sm"
                            title="Next day" aria-label="Next day"
                            @onclick="() => ChangeHistoryDateByDays(1)"
                            disabled="@historyLoading">
                        <i class="bi bi-chevron-right"></i>
                    </button>

                    <button type="button"
                            class="btn btn-outline-primary btn-sm"
                            @onclick="LoadSelectedEmployeeHistory"
                            disabled="@historyLoading">

                        <i class="bi bi-arrow-clockwise @(historyLoading ? "spin" : "")"></i>

                        <span class="d-none d-md-inline ms-1">
                            Refresh
                        </span>

                    </button>

                </div>

            </div>


            @if (historyLoading)
            {
                <div class="history-loading">

                    <span class="spinner-border spinner-border-sm me-2"></span>

                    Loading location history...

                </div>
            }
            else if (selectedHistory.Count == 0)
            {
                <div class="history-empty">

                    <i class="bi bi-geo-alt"></i>

                    <strong>
                        No GPS history recorded
                    </strong>

                    <span>
                        No location records were found for
                        @historyDate.ToString("dd MMM yyyy").
                    </span>

                </div>
            }
            else
            {
                <!-- ====================================================
                     HISTORY SUMMARY
                     ==================================================== -->

                <div class="location-history-summary">

                    <div>
                        <small>STARTED</small>
                        <strong>@HistoryStartText</strong>
                    </div>

                    <div>
                        <small>LAST UPDATE</small>
                        <strong>@HistoryEndText</strong>
                    </div>

                    <div>
                        <small>GPS POINTS</small>
                        <strong>@selectedHistory.Count</strong>
                    </div>

                    <div>
                        <small>MAX DISTANCE</small>
                        <strong>@FormatDistance(HistoryMaxDistance)</strong>
                    </div>

                    <div>
                        <small>TRAVEL</small>
                        <strong>@FormatDistance(HistoryTravelDistance)</strong>
                    </div>

                </div>



                <!-- ====================================================
                     GPS QUALITY + SESSION SUMMARY
                     ==================================================== -->

                <div class="gps-session-summary">
                    <div class="gps-quality-grid">
                        <div><small>AVG ACCURACY</small><strong class="@GetAccuracyClass(HistoryAverageAccuracy)">@GetAccuracyLabel(HistoryAverageAccuracy)</strong><span>@FormatAccuracy(HistoryAverageAccuracy)</span></div>
                        <div><small>WORST ACCURACY</small><strong class="@GetAccuracyClass(HistoryWorstAccuracy)">@GetAccuracyLabel(HistoryWorstAccuracy)</strong><span>@FormatAccuracy(HistoryWorstAccuracy)</span></div>
                        <div><small>POOR GPS POINTS</small><strong>@HistoryPoorAccuracyCount</strong><span>Accuracy &gt; 100 m</span></div>
                        <div><small>OUTSIDE RANGE</small><strong class="@(HistoryOutsideRangeCount > 0 ? "text-danger" : "text-success")">@HistoryOutsideRangeCount</strong><span>GPS points</span></div>
                        <div><small>SESSIONS</small><strong>@HistorySessionCount</strong><span>Tracking sessions</span></div>
                    </div>

                    @if (HistorySessions.Count > 0)
                    {
                        <div class="gps-session-timeline">
                            <div class="gps-session-title"><i class="bi bi-diagram-3 me-1"></i>GPS Session Timeline</div>
                            <div class="table-responsive">
                                <table class="table table-sm mb-0 gps-session-table">
                                    <thead><tr><th>Session</th><th>Started</th><th>Last Update</th><th>Duration</th><th>Points</th><th>Travel</th><th>Avg Accuracy</th><th>Status</th></tr></thead>
                                    <tbody>
                                        @foreach (var session in HistorySessions)
                                        {
                                            <tr class="@(selectedPlaybackSessionId == session.SessionId ? "gps-session-row-selected" : "")"
                                                @onclick="() => SelectPlaybackSession(session.SessionId)"
                                                title="Play this session route only">
                                                <td><code>@ShortSessionId(session.SessionId)</code></td>
                                                <td>@ToLocalTime(session.StartUtc).ToString("HH:mm:ss")</td>
                                                <td>@ToLocalTime(session.EndUtc).ToString("HH:mm:ss")</td>
                                                <td>@FormatDuration(session.EndUtc - session.StartUtc)</td>
                                                <td>@session.PointCount</td>
                                                <td>@FormatDistance(session.TravelMeters)</td>
                                                <td><span class="gps-accuracy-badge @GetAccuracyClass(session.AverageAccuracy)">@GetAccuracyLabel(session.AverageAccuracy) <small>@FormatAccuracy(session.AverageAccuracy)</small></span></td>
                                                <td>
                                                    @{
                                                        var sessionStatus =
                                                        GetHistorySessionStatus(session.SessionId);
                                                    }

                                                    @if (sessionStatus == "Active")
                                                    {
                                                        <span class="badge bg-success-subtle text-success">
                                                            <i class="bi bi-broadcast me-1"></i>
                                                            Active
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary-subtle text-secondary">
                                                            <i class="bi bi-check-circle me-1"></i>
                                                            Ended
                                                        </span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>

                <!-- ====================================================
                     PLAYBACK TOOLBAR
                     ==================================================== -->

                <div class="history-playback-toolbar">

                    <div class="history-playback-title">

                        <i class="bi bi-play-circle-fill text-primary me-1"></i>

                        Route Playback

                        @if (selectedPlaybackSessionId.HasValue)
                        {
                            <span class="badge bg-primary-subtle text-primary ms-2">
                                Session @ShortSessionId(selectedPlaybackSessionId.Value)
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary ms-2">
                                Full Day
                            </span>
                        }

                    </div>

                    <div class="history-playback-actions">

                        <button type="button"
                                class="btn btn-sm @(selectedPlaybackSessionId.HasValue ? "btn-outline-secondary" : "btn-secondary")"
                                @onclick="SelectFullDayPlayback"
                                disabled="@(!selectedPlaybackSessionId.HasValue)">
                            <i class="bi bi-calendar3 me-1"></i>
                            Full Day
                        </button>

                        <button type="button"
                                class="btn btn-sm btn-outline-primary"
                                @onclick="PlayAllEmployeesJourney"
                                disabled="@(historyDate == default)">
                            <i class="bi bi-people-fill me-1"></i>
                            All Employees Journey
                        </button>

                        <button type="button"
                                class="btn btn-sm btn-primary"
                                @onclick="PlayHistory"
                                disabled="@(!CanPlayback)">
                            <i class="bi bi-play-fill me-1"></i>
                            Play
                        </button>

                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                @onclick="PauseHistory"
                                disabled="@(!CanPlayback)">
                            <i class="bi bi-pause-fill me-1"></i>
                            Pause
                        </button>

                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                @onclick="ResetHistory"
                                disabled="@(!CanPlayback)">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>
                            Reset
                        </button>

                        <select class="form-select form-select-sm history-speed"
                                value="@playbackSpeed"
                                @onchange="ChangePlaybackSpeed">
                            <option value="0.25">0.25×</option>
                            <option value="0.5">0.5×</option>
                            <option value="1">1×</option>
                            <option value="2">2×</option>
                            <option value="4">4×</option>
                            <option value="8">8×</option>
                        </select>

                    </div>

                </div>


                <!-- ====================================================
                     PLAYBACK PROGRESS
                     ==================================================== -->

                <div class="history-playback-progress">

                    <div class="playback-progress-top">

                        <span>
                            <i class="bi bi-clock me-1"></i>

                            @playbackStatus
                        </span>

                        <strong>
                            GPS @PlaybackDisplayIndex / @PlaybackPoints.Count
                        </strong>

                    </div>

                    <input type="range"
                           class="form-range playback-range"
                           min="0"
                           max="@(Math.Max(0, PlaybackPoints.Count - 1))"
                           value="@PlaybackIndex"
                           @oninput="SeekHistoryFromSlider" />

                    <div class="playback-progress-bottom">

                        <span>
                            @PlaybackTimeText
                        </span>

                        <span>
                            @PlaybackDistanceText
                        </span>

                    </div>

                </div>


                <!-- ====================================================
                     PLAYBACK STATUS
                     ==================================================== -->

                <div class="history-playback-status">

                    <span>

                        <i class="bi bi-broadcast me-1"></i>

                        Playback:
                        <strong>@playbackStatus</strong>

                    </span>

                    <span>

                        <i class="bi bi-geo-alt me-1"></i>

                        @PlaybackPoints.Count GPS points

                    </span>

                </div>


                <!-- ====================================================
                     GPS POINTS
                     ==================================================== -->

                <details class="gps-points-collapse">
                    <summary>
                        <span>
                            <i class="bi bi-list-ol me-1"></i>
                            GPS Points
                        </span>
                        <span class="gps-points-summary-meta">
                            @selectedHistory.Count points · click to expand
                        </span>
                    </summary>

                    <div class="table-responsive">

                    <table class="table table-sm table-hover location-history-table mb-0">

                        <thead>

                            <tr>
                                <th>#</th>
                                <th>Time</th>
                                <th>Accuracy</th>
                                <th>Distance</th>
                                <th>Allowed</th>
                                <th>Status</th>
                                <th>Latitude</th>
                                <th>Longitude</th>
                            </tr>

                        </thead>

                        <tbody>

                            @for (int i = 0; i < selectedHistory.Count; i++)
                            {
                                var point = selectedHistory[i];

                                <tr class="@(PlaybackIndex == i ? "history-row-active" : "")"
                                    @onclick="() => SelectHistoryPoint(i)">

                                    <td>
                                        <span class="history-point-number">
                                            @(i + 1)
                                        </span>
                                    </td>

                                    <td class="fw-semibold">
                                        @(ToLocalTime(point.RecordedAtUtc).ToString("HH:mm:ss"))
                                    </td>

                                    <td>
                                        @FormatAccuracy(point.AccuracyMeters)
                                    </td>

                                    <td>
                                        @FormatDistance(point.DistanceFromOfficeMeters)
                                    </td>

                                    <td>
                                        @point.AllowedRadiusMeters m
                                    </td>

                                    <td>

                                        @if (point.IsWithinAllowedRadius)
                                        {
                                            <span class="history-status within">

                                                <i class="bi bi-check-circle me-1"></i>

                                                Within range

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="history-status outside">

                                                <i class="bi bi-exclamation-circle me-1"></i>

                                                Outside range

                                            </span>
                                        }

                                    </td>

                                    <td>
                                        @point.Latitude.ToString("F6")
                                    </td>

                                    <td>
                                        @point.Longitude.ToString("F6")
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                    </div>
                </details>

            }

        </div>
    }
}



