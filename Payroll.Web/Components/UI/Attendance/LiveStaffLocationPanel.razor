,0,0,.28)!important}.admin-journey-tooltip:before{border-top-color:rgba(18,25,34,.96)!important}.admin-journey-tooltip .admin-journey-popup{color:#edf4fb}.admin-journey-tooltip .journey-popup-time,.admin-journey-tooltip .journey-popup-grid span{color:#9cacbe}.admin-journey-tooltip .journey-popup-grid{border-color:rgba(255,255,255,.12)}.admin-journey-tooltip .journey-popup-grid b{color:#f2f6fb}@@keyframes journeyPulse{0%{transform:scale(.86);opacity:.8}75%{transform:scale(1.24);opacity:0}100%{transform:scale(1.24);opacity:0}}
