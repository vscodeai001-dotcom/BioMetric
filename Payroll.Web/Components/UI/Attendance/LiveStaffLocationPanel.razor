    [JSInvokable]
    public async Task LocationChanged(object? data)
    {
        if (disposed)
            return;

        try
        {
            // Never trust the pushed location payload as an authoritative
            // membership source. A delayed packet can belong to a session
            // that has already logged out. Always rebuild the active list from
            // EmployeeGpsSessions, which is the lifecycle source of truth.
            await RefreshLocations();

            // Refresh the selected employee's session records immediately so
            // the timeline cannot retain a stale Active badge after logout.
            if (selectedEmployeeId > 0)
            {
                await LoadSelectedEmployeeHistory();
            }

            mapNeedsUpdate = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Admin SignalR location update failed: {ex}");
        }
    }

