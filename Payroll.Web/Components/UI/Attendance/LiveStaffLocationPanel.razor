    private double HistoryTravelDistance
    {
        get
        {
            if (selectedHistory.Count < 2)
                return 0;

            double total = 0;

            for (int i = 1;
                 i < selectedHistory.Count;
                 i++)
            {
                total += CalculateDistance(
                    selectedHistory[i - 1].Latitude,
                    selectedHistory[i - 1].Longitude,
                    selectedHistory[i].Latitude,
                    selectedHistory[i].Longitude);
            }

            return total;
        }
    }


    private static double CalculateDistance(
        double lat1,
        double lon1,
        double lat2,
        double lon2)
    {
        const double earthRadius =
            6371000;

        var r1 =
            lat1 * Math.PI / 180;

        var r2 =
            lat2 * Math.PI / 180;

        var dLat =
            (lat2 - lat1) *
            Math.PI / 180;

        var dLon =
            (lon2 - lon1) *
            Math.PI / 180;

        var a =
            Math.Sin(dLat / 2) *
            Math.Sin(dLat / 2) +
            Math.Cos(r1) *
            Math.Cos(r2) *
            Math.Sin(dLon / 2) *
            Math.Sin(dLon / 2);

        var c =
            2 *
            Math.Atan2(
                Math.Sqrt(a),
                Math.Sqrt(1 - a));

        return earthRadius * c;
    }


    private LiveEmployeeLocation? GetLocation(
