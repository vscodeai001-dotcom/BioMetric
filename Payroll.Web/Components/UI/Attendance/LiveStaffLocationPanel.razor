    private async Task PlayAllEmployeesJourney()
    {
        await StopPlayback();
        workforceReplayActive = false;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            TimeZoneInfo indiaTimeZone;
            try
            {
                indiaTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Asia/Kolkata");
            }
            catch (TimeZoneNotFoundException)
            {
                indiaTimeZone = TimeZoneInfo.FindSystemTimeZoneById("India Standard Time");
            }

            var localStart = DateTime.SpecifyKind(historyDate.Date, DateTimeKind.Unspecified);
            var localEnd = DateTime.SpecifyKind(historyDate.Date.AddDays(1), DateTimeKind.Unspecified);
            var startUtc = TimeZoneInfo.ConvertTimeToUtc(localStart, indiaTimeZone);
            var endUtc = TimeZoneInfo.ConvertTimeToUtc(localEnd, indiaTimeZone);

            var employeeIds = employees.Select(e => e.EmployeeID).ToList();
            if (employeeIds.Count == 0)
                return;

            var rows = await db.EmployeeLocationHistory
                .AsNoTracking()
                .Where(x => employeeIds.Contains(x.EmployeeId) &&
                            x.RecordedAtUtc >= startUtc &&
                            x.RecordedAtUtc < endUtc)
                .OrderBy(x => x.EmployeeId)
                .ThenBy(x => x.RecordedAtUtc)
                .ToListAsync();

            var names = employees.ToDictionary(e => e.EmployeeID, e => e.Name ?? "Employee");

            var tracks = rows
                .GroupBy(x => x.EmployeeId)
                .Where(g => g.Any())
                .Select(g => new WorkforceReplayTrack
                {
                    EmployeeId = g.Key,
                    Name = names.TryGetValue(g.Key, out var name) ? name : "Employee",
                    Points = g.Select(x => new WorkforceReplayPoint
                    {
                        Latitude = x.Latitude,
                        Longitude = x.Longitude,
                        AccuracyMeters = x.AccuracyMeters,
                        DistanceFromOfficeMeters = x.DistanceFromOfficeMeters,
                        AllowedRadiusMeters = x.AllowedRadiusMeters,
                        IsWithinAllowedRadius = x.IsWithinAllowedRadius,
                        RecordedAtUtc = x.RecordedAtUtc
                    }).ToList()
                })
                .OrderBy(x => x.Name)
                .ToList();

            if (tracks.Count == 0)
                return;

            workforceReplayActive = true;

            await JSRuntime.InvokeVoidAsync(
                "startAdminWorkforceJourneyReplay",
                mapId,
                tracks,
                historyDate.ToString("yyyy-MM-dd"));

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            workforceReplayActive = false;
            Console.Error.WriteLine($"Admin workforce journey replay failed: {ex}");
        }
    }


